#
# SomatoSync wearable sensor node — openvela on the custom ESP32-S3 node board.
#
# Hand-maintained baseline derived from the upstream, proven-good board
#   vendor/espressif/boards/esp32s3/esp32s3-eye/configs/openvela/defconfig
#
# Build:
#   ./build.sh vendor/espressif/boards/esp32s3/somatosync_esp32s3/configs/node -j$(nproc)
#
# The node is the TDMA slave: dual ICM-42688 IMUs on two independent SPI
# buses, per-IMU LDO gating, an external 32.768 kHz clock, SSD1306 OLED and
# DRV2605 haptics on I2C0, and a Li-Po fuel-gauge divider on ADC1_CH1.
#
# CONFIG_ARCH_LEDS is not set
CONFIG_ALLOW_BSD_COMPONENTS=y
CONFIG_ARCH="xtensa"
CONFIG_ARCH_BOARD_COMMON=y
CONFIG_ARCH_BOARD_CUSTOM=y
CONFIG_ARCH_BOARD_CUSTOM_DIR="../vendor/espressif/boards/esp32s3/somatosync_esp32s3"
CONFIG_ARCH_BOARD_CUSTOM_DIR_RELPATH=y
CONFIG_ARCH_BOARD_CUSTOM_NAME="somatosync_esp32s3"
CONFIG_ARCH_CHIP="esp32s3"
CONFIG_ARCH_CHIP_ESP32S3=y
CONFIG_ARCH_CHIP_ESP32S3WROOM1N4=y
CONFIG_ARCH_INTERRUPTSTACK=2048
CONFIG_ARCH_STACKDUMP=y
CONFIG_ARCH_XTENSA=y
CONFIG_BOARD_LOOPSPERMSEC=16717
CONFIG_BUILTIN=y
CONFIG_DEBUG_FULLOPT=y
CONFIG_DEBUG_SYMBOLS=y
CONFIG_DEFAULT_TASK_STACKSIZE=4096
CONFIG_HAVE_CXXINITIALIZE=y
CONFIG_IDLETHREAD_STACKSIZE=3072
CONFIG_INIT_ENTRYPOINT="nsh_main"
CONFIG_INIT_STACKSIZE=3072
CONFIG_INTELHEX_BINARY=y
CONFIG_IOB_NBUFFERS=124
CONFIG_IOB_THROTTLE=24
CONFIG_LINE_MAX=64
CONFIG_MM_REGIONS=2
CONFIG_NAME_MAX=48
CONFIG_PREALLOC_TIMERS=4
CONFIG_PTHREAD_MUTEX_TYPES=y
CONFIG_RAM_SIZE=114688
CONFIG_RAM_START=0x20000000
CONFIG_RR_INTERVAL=200
CONFIG_SCHED_WAITPID=y
CONFIG_SIG_DEFAULT=y
CONFIG_SMP=y
CONFIG_SMP_NCPUS=2
CONFIG_TIMER=y

#
# Task-local storage: the esp32s3 Wi-Fi adapter calls
# task_tls_alloc()/task_tls_get_value()/task_tls_set_value().
#
CONFIG_TLS_TASK_NELEM=4

#
# Board: SomatoSync wearable node variant
#
CONFIG_SOMATOSYNC_BOARD_NODE=y
CONFIG_SOMATOSYNC_OLED=y
CONFIG_SOMATOSYNC_WIFI=y
# CONFIG_SOMATOSYNC_W5500 is not set
# CONFIG_SOMATOSYNC_SDCARD is not set
# CONFIG_SOMATOSYNC_NFC is not set

# Dual-IMU sensor registration is off by default: confirm first whether
# drivers/sensors/ in your checkout already ships an ICM-42688 driver.
# CONFIG_SOMATOSYNC_IMU is not set

#
# ESP32-S3 SoC options
#
CONFIG_ESP32S3_GPIO_IRQ=y
CONFIG_ESP32S3_POWER_SAVE_NONE=y
CONFIG_ESP32S3_RT_TIMER_TASK_STACK_SIZE=4096
CONFIG_ESP32S3_SPIRAM=y
CONFIG_ESP32S3_SPIRAM_MODE_OCT=y
CONFIG_ESP32S3_USBSERIAL=y
CONFIG_DEV_GPIO=y

#
# I2C0 — SSD1306 OLED + DRV2605 haptics (SCL 37 / SDA 38)
#
CONFIG_I2C=y
CONFIG_I2C_DRIVER=y
CONFIG_ESP32S3_I2C0=y
CONFIG_ESP32S3_I2C0_SCLPIN=37
CONFIG_ESP32S3_I2C0_SDAPIN=38
CONFIG_LCD=y
CONFIG_LCD_DEV=y
CONFIG_LCD_FRAMEBUFFER=y
CONFIG_LCD_MAXCONTRAST=255
CONFIG_LCD_MAXPOWER=1
CONFIG_LCD_LANDSCAPE=y
CONFIG_LCD_UG2864HSWEG01=y
CONFIG_LCD_SSD1306_I2C=y
CONFIG_SSD1306_NUMDEVS=1
CONFIG_SSD1306_I2CADDR=60
CONFIG_SSD1306_I2CFREQ=400000

#
# SPI2 / SPI3 — the two ICM-42688 IMU buses
#   IMU-A on SPI2: CS 6 / SCLK 7 / MOSI 8 / MISO 9 / INT 10
#   IMU-B on SPI3: CS 16 / SCLK 15 / MOSI 14 / MISO 13 / INT 12
#
CONFIG_SPI=y
CONFIG_SPI_EXCHANGE=y
CONFIG_ESP32S3_SPI=y
CONFIG_ESP32S3_SPI2=y
CONFIG_ESP32S3_SPI2_CLKPIN=7
CONFIG_ESP32S3_SPI2_MOSIPIN=8
CONFIG_ESP32S3_SPI2_MISOPIN=9
CONFIG_ESP32S3_SPI2_CSPIN=6
# CONFIG_ESP32S3_SPI3 is not set

#
# ADC1_CH1 — Li-Po fuel-gauge divider (gate 1 / ADC 2)
#
CONFIG_ESP32S3_ADC=y
CONFIG_ADC=y

#
# Wi-Fi / ESP-NOW TDMA transport
#
CONFIG_ESP32S3_WIFI=y
CONFIG_DRIVERS_IEEE80211=y
CONFIG_DRIVERS_WIRELESS=y
CONFIG_NETDEV_LATEINIT=y
CONFIG_NETDEV_PHY_IOCTL=y
CONFIG_NETDEV_WIRELESS_IOCTL=y
CONFIG_WIRELESS=y
CONFIG_WIRELESS_WAPI=y
CONFIG_WIRELESS_WAPI_CMDTOOL=y
CONFIG_WIRELESS_WAPI_INITCONF=y
CONFIG_WIRELESS_WAPI_STACKSIZE=8192

#
# Network stack (ESP-NOW peer-to-peer plus UDP to the gateway)
#
CONFIG_NET=y
CONFIG_NET_BROADCAST=y
CONFIG_NET_UDP=y
CONFIG_NET_UDP_CHECKSUMS=y
CONFIG_NET_UDP_WRITE_BUFFERS=y
CONFIG_NET_ICMP_SOCKET=y
CONFIG_NET_LOOPBACK=y

#
# Filesystem, shell and diagnostics
#
CONFIG_FS_PROCFS=y
CONFIG_FS_TMPFS=y
CONFIG_SYSTEM_NSH=y
CONFIG_NSH_ARCHINIT=y
CONFIG_NSH_BUILTIN_APPS=y
CONFIG_NSH_READLINE=y
CONFIG_NSH_FILEIOSIZE=512
CONFIG_SYSTEM_I2CTOOL=y
CONFIG_SYSLOG_BUFFER=y
CONFIG_SYSLOG_CONSOLE=y

#
# Optional: on-device LVGL demo on the OLED framebuffer (see the gateway
# defconfig note).
#
# CONFIG_GRAPHICS_LVGL is not set
# CONFIG_EXAMPLES_LVGLDEMO is not set

#
# Build prerequisites that "make savedefconfig" strips because they equal
# their Kconfig defaults, but which a fresh configure.sh may fail to re-apply
# on a machine without kconfig-tweak. Without them the build breaks in two
# confusing ways (both hit on real hardware during this port):
#
#   CONFIG_XTENSA_TOOLCHAIN_ESP  -> arch/xtensa/src/lx7/Toolchain.defs derives
#       CROSSDEV from it. If unset, CROSSDEV is empty and CC falls back to the
#       host gcc, which then rejects '-mlongcalls'.
#   CONFIG_STACK_USAGE_WARNING   -> the same file does
#       "ifneq ($(CONFIG_STACK_USAGE_WARNING),0)", so an *undefined* symbol
#       (empty) is not equal to 0 and emits an invalid '-Wstack-usage=' that
#       gcc rejects with "missing argument".
#
CONFIG_XTENSA_TOOLCHAIN_ESP=y
CONFIG_STACK_USAGE_WARNING=0
